LARK_APP_ID=cli_xxxxxxxxxxxxx
LARK_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Mainland Feishu: https://open.feishu.cn
# Global Lark: https://open.larksuite.com
LARK_API_BASE_URL=https://open.feishu.cn

# Small web control panel for turning the server auto-reply PM2 process on/off.
# Run as a separate PM2 app so stopping lark-autoreply does not stop this panel.
LARK_CONTROL_PANEL_HOST=0.0.0.0
LARK_CONTROL_PANEL_PORT=8788
LARK_CONTROL_PANEL_USERNAME=admin
LARK_CONTROL_PANEL_PASSWORD=replace-with-a-strong-password
LARK_CONTROL_PANEL_SESSION_SECRET=replace-with-a-long-random-secret
LARK_CONTROL_PANEL_PM2_APP=lark-autoreply
# Normal login duration is 12 hours. Remember-login duration is 30 days.
LARK_CONTROL_PANEL_SESSION_SECONDS=43200
LARK_CONTROL_PANEL_REMEMBER_SECONDS=2592000
LARK_AUTOREPLY_SWITCHES_FILE=.lark-auto-reply-switches.json
LARK_AUTOREPLY_SWITCHES_RELOAD_MS=1000

# OAuth scope mode for npm.cmd run oauth:login:
# default = do not include scope in the authorize URL
# offline = request only offline_access, useful for getting refresh_token without a long full-scope URL
# full = request LARK_OAUTH_SCOPES exactly
# full_with_offline = request LARK_OAUTH_SCOPES plus offline_access
LARK_OAUTH_SCOPE_MODE=default
LARK_OAUTH_SCOPES=auth:user.id:read contact:user:search im:message im:message:readonly im:message.p2p_msg:get_as_user im:message.send_as_user search:docs:read docs:document.content:read drive:drive:readonly mail:user_mailbox:readonly mail:mail:readonly mail:message:readonly
LARK_OAUTH_INCLUDE_SCOPES=false
LARK_USER_API_TIMEOUT_MS=15000

# Auto reply defaults: reply to contacts under R&D, Product, Project, and Global Business centers plus explicit people.
# Preferred target syntax supports people and departments:
# LARK_AUTOREPLY_TARGETS=person:谷力刚,person:陈威,department:软件部
# LARK_AUTOREPLY_TARGETS=department:研发中心,department_id:od-xxxxxxxxxxxx
# Group chats are supported by chat_id and only trigger when someone mentions you.
# LARK_AUTOREPLY_TARGETS=chat:oc_xxxxxxxxxxxxx
LARK_AUTOREPLY_TARGETS=department:研发中心,department:产品中心,department:项目中心,department:Global Business,person:陈威,person:刘峥
# Excluded names are removed even if they appear under a configured department.
LARK_AUTOREPLY_EXCLUDE_TARGET_NAMES=何运伟,李文贤
# Backward-compatible people-only syntax. Ignored when LARK_AUTOREPLY_TARGETS is set.
LARK_AUTOREPLY_TARGET_NAMES=谷力刚,陈威
LARK_AUTOREPLY_TARGET_NAME=陈威
# Fixed replies use | as escalation levels for repeated messages in the same chat.
LARK_AUTOREPLY_TEXTS=我现在不在，消息还没收到，先别急着把锅扣过来。|你又召唤了一次，但我这边还是离线状态。|第三次呼叫已记录，我本人依旧没有上线。
# Fixed targets listed here still use fixed text, but are scanned in the low-latency priority loop.
LARK_AUTOREPLY_PRIORITY_FIXED_TARGET_NAMES=person:Lee
LARK_AUTOREPLY_MARKER=ᵃʳ
LARK_AUTOREPLY_REPLY_TO_SOURCE_MESSAGE_ENABLED=true
# false by default: after the process starts, do not reply to messages accumulated while it was stopped.
LARK_AUTOREPLY_REPLY_EXISTING=false
LARK_AUTOREPLY_POLL_SECONDS=1
LARK_AUTOREPLY_POLL_OVERLAP_SECONDS=120
LARK_AUTOREPLY_LOOKBACK_SECONDS=300
LARK_SMART_REPLY_MAX_MESSAGES=3
LARK_STYLE_LEARN_MAX_MESSAGES_PER_CHAT=200
LARK_STYLE_LEARN_MODE=broad
LARK_SELF_REVIEW_MAX_CASES=30
LARK_SELF_REVIEW_PASS_SCORE=7
LARK_SELF_REVIEW_AI_JUDGE=true
LARK_REALTIME_WEATHER_ENABLED=true
LARK_REALTIME_WEATHER_DEFAULT_LOCATION=
LARK_REALTIME_REPLY_DELAY_MS=1800
LARK_KNOWLEDGE_ENABLED=true
LARK_KNOWLEDGE_SYNC_MONITORED_CHATS=true
LARK_KNOWLEDGE_SYNC_ALL_CHAT_MESSAGES=true
LARK_KNOWLEDGE_SYNC_DAYS=180
LARK_KNOWLEDGE_MAX_CHATS=160
LARK_KNOWLEDGE_MAX_MESSAGES_PER_CHAT=300
LARK_KNOWLEDGE_SYNC_DELAY_MS=600
LARK_KNOWLEDGE_SYNC_RATE_LIMIT_BACKOFF_MS=3000
LARK_KNOWLEDGE_CHECKPOINT_AFTER_CHATS=true
LARK_KNOWLEDGE_SEARCH_CLOUD_DOCS=true
LARK_KNOWLEDGE_SEARCH_KEYS=DK057,DK075,项目,需求,问题,进度,风险,会议,方案
LARK_KNOWLEDGE_SYNC_MAIL=true
LARK_KNOWLEDGE_MAIL_DAYS=180
LARK_KNOWLEDGE_MAIL_MAX_MESSAGES=500
LARK_KNOWLEDGE_SEARCH_LIMIT=12
# Feishu does not expose your UI read/unread state for messages others sent to you.
# This optional guard approximates it: before sending, wait briefly and skip if you already replied manually.
LARK_AUTOREPLY_SKIP_IF_SELF_REPLIED_ENABLED=false
LARK_AUTOREPLY_SELF_REPLY_CHECK_DELAY_MS=2000
LARK_AUTOREPLY_MAX_DEPARTMENT_USERS=1000
LARK_AUTOREPLY_MAX_DEPARTMENT_DEPTH=6
# Keep this false for large departments to avoid Feishu contact-search rate limits.
LARK_AUTOREPLY_SEARCH_MISSING_DEPARTMENT_CHAT_IDS=false

# External contacts may require extra Feishu external-chat permissions and a fresh oauth:login.
# External contacts are monitored from your user chat history, then replied to by the bot identity.
# The external user must have opened/authorized a single chat with the bot first.

# Preferred working mode for personal direct chats: polling with the user token.
# Start with: npm.cmd run autoreply

# Event callback mode: no chat_id is needed. Configure this URL in Feishu events:
# http://<your-public-host>:8790/feishu/events
LARK_AUTOREPLY_WEBHOOK_HOST=0.0.0.0
LARK_AUTOREPLY_WEBHOOK_PORT=8790
LARK_AUTOREPLY_WEBHOOK_PATH=/feishu/events
# Optional: paste the Feishu event verification token here if configured.
# LARK_EVENT_VERIFICATION_TOKEN=xxxxxxxx

# Optional, but recommended if auto discovery cannot find a single direct chat/user.
# LARK_AUTOREPLY_TARGET_OPEN_ID=ou_xxxxxxxxxxxxx
# LARK_AUTOREPLY_CHAT_ID=oc_xxxxxxxxxxxxx
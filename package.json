{
  "name": "lark-copilot-mcp",
  "version": "0.1.0",
  "description": "MCP server that lets GitHub Copilot interact with Feishu/Lark Open Platform APIs.",
  "type": "module",
  "private": true,
  "bin": {
    "lark-copilot-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "autoreply": "tsx src/autoReply.ts",
    "knowledge:sync": "tsx src/knowledgeSync.ts",
    "autoreply:webhook": "tsx src/autoReplyWebhook.ts",
    "autoreply:ws": "tsx src/autoReplyWs.ts",
    "smart:evaluate": "tsx src/smartReplyEval.ts",
    "oauth:login": "tsx src/oauthLogin.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@larksuiteoapi/node-sdk": "^1.66.0",
    "@modelcontextprotocol/server": "^2.0.0-alpha.2",
    "dotenv": "^16.4.7",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@cfworker/json-schema": "^4.1.1",
    "@modelcontextprotocol/client": "^2.0.0-alpha.2",
    "@types/node": "^24.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
